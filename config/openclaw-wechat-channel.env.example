# Copy to /etc/openclaw-wechat-channel.env on the Linux host.
# Do not commit real tokens or private chat IDs in public repos.

AGENT_WECHAT_UPSTREAM_URL=http://127.0.0.1:6174
AGENT_WECHAT_CACHE_URL=http://127.0.0.1:6175
AGENT_WECHAT_URL=http://127.0.0.1:6175
AGENT_WECHAT_TOKEN_FILE=/opt/docker/agent-wechat/secrets/token

# Local cache proxy. It caches only safe read endpoints and forwards sends/media.
AGENT_WECHAT_CACHE_BIND=127.0.0.1
AGENT_WECHAT_CACHE_PORT=6175
AUTH_CACHE_TTL_SECONDS=30
CHATS_CACHE_TTL_SECONDS=20
MESSAGES_CACHE_TTL_SECONDS=12
CHATS_PREFETCH_LIMIT=50
MESSAGES_PREFETCH_LIMIT=50
AGENT_WECHAT_ALLOWED_CHAT_IDS=your_dm_or_group_id,your_group_id@chatroom

# Comma-separated WeChat chat IDs enabled for helper services.
# Example group IDs look like 123456789@chatroom.
CHAT_IDS=your_group_id@chatroom

# Bot display names used by mention repair and proactive observer.
MENTION_TERMS=@your_bot_name
BOT_NAMES=your_bot_name
AT_TERMS=@your_bot_name

# Voice call helper configuration. Keep real IDs and member aliases private.
WECHAT_GROUP_CALL_BOT_NAMES=your_bot_name
WECHAT_GROUP_CALL_CHATROOMS_JSON='{"your_group_id@chatroom":["Your Group Title"]}'
WECHAT_GROUP_CALL_MEMBERS_JSON='{"Member Display Name":["member alias"]}'
WECHAT_INCOMING_VOICE_CHAT_ID=your_group_id@chatroom

# Mention repair only sends fallback text when a mention appears to be missed
# before it reaches OpenClaw. If OpenClaw session traces already contain the
# mention text, the repair service suppresses its fallback so long-running tool
# calls can finish and send their normal answer.
OPENCLAW_TRACE_DIR=/root/.openclaw/agents/main/sessions
OPENCLAW_SEEN_SUPPRESS=1
OPENCLAW_TRACE_LOOKBACK_SECONDS=7200

# Proactive observer defaults.
IDLE_TRIGGER_SECONDS=259200
PROACTIVE_COOLDOWN_SECONDS=21600
IDLE_PROACTIVE_COOLDOWN_SECONDS=86400
MAX_PROACTIVE_PER_DAY=3
