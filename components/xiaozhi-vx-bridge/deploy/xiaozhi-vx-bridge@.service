[Unit]
Description=vx group-call to Xiaozhi voice bridge (%I)
After=docker.service network-online.target hermes-openwrt-route.service
Wants=network-online.target
Requires=docker.service hermes-openwrt-route.service
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=root
Environment="WECHAT_PULSE_BRIDGE_DIR=/opt/wechat-gpt-voice-bridge"
ExecStart=/opt/xiaozhi-vx-bridge/.venv/bin/python /opt/xiaozhi-vx-bridge/call_bridge.py --chat-id %I
ExecStopPost=/opt/xiaozhi-vx-bridge/.venv/bin/python /opt/wechat-gpt-voice-bridge/pulse_audio.py --cleanup
Restart=no
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/lock

[Install]
WantedBy=multi-user.target
