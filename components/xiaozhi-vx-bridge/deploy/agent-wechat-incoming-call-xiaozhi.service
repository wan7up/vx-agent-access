[Unit]
Description=Agent vx incoming call to Xiaozhi voice observer
After=docker.service network-online.target hermes-openwrt-route.service
Wants=network-online.target
Requires=docker.service hermes-openwrt-route.service

[Service]
Type=simple
EnvironmentFile=-/etc/openclaw-wechat-channel.env
ExecStart=/usr/local/bin/agent-wechat-incoming-call.py
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/run/lock /var/lib/wechat-gpt-voice-bridge

[Install]
WantedBy=multi-user.target
