[Unit]
Description=Private WeChat group-call to Codex Voice bridge (%I)
After=docker.service network-online.target codex-voice-gateway.service
Wants=network-online.target codex-voice-gateway.service
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=root
EnvironmentFile=/etc/wechat-gpt-voice-bridge.env
ExecStartPre=/usr/local/sbin/codex-voice-gateway-refresh.sh
ExecStart=/usr/bin/python3 /opt/wechat-gpt-voice-bridge/bridge.py --chat-id %I
ExecStopPost=/usr/bin/python3 /opt/wechat-gpt-voice-bridge/pulse_audio.py --cleanup
Restart=no
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/wechat-gpt-voice-bridge

[Install]
WantedBy=multi-user.target
