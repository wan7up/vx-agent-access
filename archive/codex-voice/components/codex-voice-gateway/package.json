{
  "name": "codex-voice-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild src/client.ts --bundle --format=esm --target=es2022 --outfile=public/app.js",
    "dev": "npm run build && tsx src/index.ts",
    "start": "node dist/index.js",
    "doctor": "tsx src/doctor.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/static": "^10.1.2",
    "@roamhq/wrtc": "^0.10.0",
    "fastify": "^5.3.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.14",
    "esbuild": "^0.25.5",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
