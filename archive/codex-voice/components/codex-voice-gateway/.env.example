# Keep this directory distinct from ~/.codex. Create it with chmod 700 before login.
VOICE_GATEWAY_PROJECT_DIR=/opt/codex-voice/gateway
VOICE_GATEWAY_CODEX_HOME=/var/lib/codex-voice-gateway/codex-home
VOICE_GATEWAY_DATA_DIR=/var/lib/codex-voice-gateway/data

# Local development only. Set this to your exact https://<machine>.<tailnet>.ts.net origin
# before placing the service behind Tailscale Serve.
# Comma-separated exact origins. Keep localhost only for local validation.
VOICE_GATEWAY_ALLOWED_ORIGINS=http://127.0.0.1:4317
VOICE_GATEWAY_HOST=127.0.0.1
VOICE_GATEWAY_PORT=4317

VOICE_GATEWAY_CODEX_BIN=/opt/codex-voice/bin/codex

# Optional: enables the non-browser WeChat Voice Bridge WebSocket. Generate
# a unique 32-byte value and store the same secret in the Linux bridge env file.
VOICE_GATEWAY_BRIDGE_TOKEN=replace-with-a-random-32-byte-secret
